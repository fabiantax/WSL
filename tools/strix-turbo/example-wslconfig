################################################################################
#                              TROUBLESHOOTING
################################################################################

# If WSL won't start after adding custom kernel:
# 1. Comment out the kernel line
# 2. Run: wsl --shutdown
# 3. Restart WSL
# 4. Check kernel file exists: dir C:\Users\YourUsername\WSL-Kernels
# 5. Check Windows Event Viewer for errors
# 6. Try: wsl --update

# If you get "Not enough memory" errors:
# 1. Reduce the memory setting
# 2. Close other applications
# 3. Increase swap space

# If network is slow:
# 1. Check if network mode is set correctly
# 2. Test: time curl https://www.google.com
# 3. Monitor with: watch -n 1 'ifstat'

# For detailed diagnostics:
# 1. Run in PowerShell: Get-Service -Name LxssManager | Restart-Service
# 2. Check WSL version: wsl --version
# 3. List installations: wsl --list --verbose


################################################################################
#                           FURTHER OPTIMIZATION
################################################################################

# After setting up the kernel and this config, optimize within WSL:

# Edit /etc/sysctl.conf as root:
# sudo nano /etc/sysctl.conf

# Add these performance tuning options:
#
# # Networking
# net.ipv4.tcp_tw_reuse=1
# net.ipv4.tcp_timestamps=0
# net.ipv4.tcp_fast_open=3
# net.core.somaxconn=4096
#
# # CPU Scheduling
# kernel.sched_migration_cost_ns=500000
#
# # Memory
# vm.swappiness=10
# vm.vfs_cache_pressure=50
#
# Then apply: sudo sysctl -p

# For I/O optimization, set scheduler to BFQ:
# sudo nano /etc/udev/rules.d/90-io-scheduler.rules
# Add: ACTION=="add|change", KERNEL=="sd*", ATTR{queue/scheduler}="bfq"

