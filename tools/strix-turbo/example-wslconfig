# Example .wslconfig for WSL2 with Custom Zen 5 Kernel
#
# Location: C:\Users\<YourUsername>\.wslconfig
#
# Instructions:
# 1. Copy this file to C:\Users\<YourUsername>\.wslconfig
# 2. Replace <YourUsername> with your actual Windows username
# 3. Replace the kernel path with the actual path from build-zen5-kernel.sh output
# 4. Restart WSL2: wsl --shutdown, then open terminal again
#
# For more options, see: https://docs.microsoft.com/en-us/windows/wsl/wslconfig

[wsl2]
# Path to custom Zen 5 optimized kernel
# Replace with the actual kernel path from build output
kernel=C:\Users\YourUsername\WSL-Kernels\bzImage-latest

# Memory allocation (adjust based on your system)
# Default: 50% of your Windows RAM
# memory=8GB

# CPU cores to allocate (adjust based on your system)
# Default: All cores
# processors=8

# Virtual disk size (automatically expands, but set a max)
# Default: 256GB
# swap=4GB

# Enable localhost port forwarding
localhostForwarding=true

# Use network mirroring (Windows 11 22H2+)
# networkingMode=mirrored

# Enable debug console
# debugConsole=true

[interop]
# Enable .exe interoperability
enabled=true

# Append Windows PATH to WSL PATH
appendWindowsPath=true

[user]
# Default user to login as (optional)
# default=username

[boot]
# Systemd support (Ubuntu 22.04+)
# systemd=true


################################################################################
#                          PERFORMANCE TUNING NOTES
################################################################################

# For maximum performance with Zen 5 kernel:

# 1. Memory: Set to 60-80% of your Windows RAM for optimal performance
#    Example on 16GB Windows: memory=10GB or memory=12GB

# 2. Processors: Use all available cores for parallel tasks
#    Example on 8-core system: processors=8

# 3. Swap: Keep some swap space for emergencies
#    swap=4GB or swap=8GB

# 4. Network Mode: Use mirrored networking (Windows 11 22H2+)
#    Provides better network performance and simpler IP management

# 5. Additional runtime tuning in WSL:
#    - Disable unnecessary services: sudo systemctl disable <service>
#    - Adjust swappiness: echo vm.swappiness=10 | sudo tee /etc/sysctl.conf
#    - Use BFQ I/O scheduler (if available)


