<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- <ApplicationIcon>wsl-perf.ico</ApplicationIcon> -->
    <AssemblyName>WSLPerfMonitor</AssemblyName>
    <RootNamespace>WSLPerfMonitor</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Strix-Turbo</Company>
    <Product>WSL Performance Monitor</Product>
    <Description>Real-time monitoring for WSL2 filesystem performance issues</Description>
    <Copyright>MIT License</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>


</Project>
