# =============================================================================
# Real-World Workload Simulations
# =============================================================================

[workload-database]
stonewall
description=Database Workload Simulation
rw=randrw
rwmixread=80
bs=8k
numjobs=8
iodepth=32
size=4G
runtime=60

[workload-build]
stonewall
description=Build System Workload (many small reads)
rw=randread
bs=4k
numjobs=16
iodepth=16
size=2G
runtime=60
# Simulate compiler reading many small files
filesize=64k
nrfiles=1000
openfiles=100

[workload-git]
stonewall
description=Git Operations Workload
rw=randrw
rwmixread=90
bs=4k
numjobs=4
iodepth=8
size=1G
runtime=60

# =============================================================================
# NVMe Passthrough Validation
# =============================================================================

[passthrough-validation]
stonewall
description=NVMe Passthrough Validation
# This should show near-native NVMe speeds
# Native NVMe: ~1M IOPS random 4K read
# VHDX overhead: ~50-100K IOPS
# Passthrough target: ~800K+ IOPS
rw=randread
bs=4k
numjobs=16
iodepth=256
size=8G
runtime=120

# =============================================================================
# Endurance/Stability Test
# =============================================================================

[endurance-test]
stonewall
description=Endurance Test - 10 minute sustained load
rw=randrw
rwmixread=70
bs=4k
numjobs=8
iodepth=64
size=16G
runtime=600
time_based=1
