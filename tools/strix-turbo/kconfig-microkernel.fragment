# =============================================================================
# Strix-Turbo Microkernel Configuration Fragment
# =============================================================================
#
# This Kconfig fragment strips the Linux kernel to bare minimum for WSL2.
# Target: Maximum I/O throughput, minimum memory footprint, fastest boot.
#
# Expected results:
#   - Boot time: ~0.5s (vs ~2s stock)
#   - Memory footprint: ~50MB (vs ~150MB stock)
#   - I/O latency: ~10% reduction from removed overhead
#
# Usage:
#   cd WSL2-Linux-Kernel
#   ./scripts/kconfig/merge_config.sh \
#       Microsoft/config-wsl \
#       /path/to/kconfig-microkernel.fragment
#   make -j$(nproc)
#
# WARNING: This is an aggressive configuration. Test thoroughly.
# =============================================================================

# =============================================================================
# CRITICAL: Keep These Enabled
# =============================================================================

# Hyper-V guest support (required for WSL2)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_HYPERV=y
CONFIG_HYPERV_TIMER=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y

# VirtIO (required for WSL2 I/O)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_PMEM=y
CONFIG_VIRTIO_MEM=y

# 9p filesystem (required for /mnt/c, but we're replacing it)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# =============================================================================
# PERFORMANCE: io_uring (CRITICAL for 10x)
# =============================================================================

CONFIG_IO_URING=y
CONFIG_IO_WQ=y

# Enable all io_uring features
# (No explicit configs needed, enabled by CONFIG_IO_URING=y)

# =============================================================================
# PERFORMANCE: Block Layer Optimizations
# =============================================================================

# Multi-queue block layer
CONFIG_BLK_MQ_PCI=y
CONFIG_BLK_MQ_VIRTIO=y

# Use multi-queue scheduling
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
# CONFIG_MQ_IOSCHED_BFQ is not set  # BFQ adds overhead

# Default to none scheduler (lowest latency for NVMe)
CONFIG_DEFAULT_IOSCHED="none"

# NVMe optimizations
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y

# Disable legacy single-queue
# CONFIG_SCSI_MQ_DEFAULT is not set
# CONFIG_BLK_SQ is not set

# =============================================================================
# PERFORMANCE: CPU Optimizations (Zen 5)
# =============================================================================

# Processor family (Zen 5 = AMD Zen 4 family in kernel)
CONFIG_MZEN4=y
# Or for generic AVX-512 support:
# CONFIG_GENERIC_CPU=y
# CONFIG_X86_64_VERSION=4

# CPU features
CONFIG_X86_CMPXCHG64=y
CONFIG_X86_USE_PPRO_CHECKSUM=y
CONFIG_X86_TSC=y
CONFIG_X86_P6_NOP=y
CONFIG_X86_INVLPG=y

# AVX-512 support in kernel
CONFIG_AS_AVX512=y
CONFIG_CRYPTO_AVX512=y

# Disable mitigations (DANGEROUS but faster - for trusted workloads only)
# CONFIG_RETPOLINE is not set
# CONFIG_CPU_IBPB_ENTRY is not set
# CONFIG_CPU_IBRS_ENTRY is not set
# Uncomment above only if you understand the security implications

# =============================================================================
# PERFORMANCE: Memory Management
# =============================================================================

# Transparent Huge Pages (2MB pages reduce TLB misses)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# 1GB huge pages (for large memory workloads)
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y

# Memory compaction (helps THP)
CONFIG_COMPACTION=y

# NUMA (disable for WSL2 - single socket)
# CONFIG_NUMA is not set
# CONFIG_AMD_NUMA is not set

# Memory allocator
CONFIG_SLUB=y
# CONFIG_SLAB is not set
# CONFIG_SLOB is not set

# =============================================================================
# PERFORMANCE: Scheduler
# =============================================================================

# Preemption model (NONE = maximum throughput)
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set

# No HZ tick during idle (saves power, reduces overhead)
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=y

# Timer frequency (lower = less overhead, but higher latency)
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
# CONFIG_HZ_1000 is not set

# =============================================================================
# PERFORMANCE: Networking (Minimal)
# =============================================================================

CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Enable TCP fastopen
CONFIG_TCP_FASTOPEN=y

# Disable unused protocols
# CONFIG_IPX is not set
# CONFIG_ATALK is not set
# CONFIG_DECnet is not set
# CONFIG_ECONET is not set
# CONFIG_WAN_ROUTER is not set
# CONFIG_PHONET is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_MAC802154 is not set
# CONFIG_NFC is not set
# CONFIG_CAIF is not set
# CONFIG_CEPH_LIB is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
# CONFIG_L2TP is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_LLC is not set

# =============================================================================
# FILESYSTEMS: Minimal Set
# =============================================================================

# Required
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# FUSE (for strix-fuse custom filesystem)
CONFIG_FUSE_FS=y
CONFIG_FUSE_DAX=y
CONFIG_VIRTIO_FS=y

# Optional (can be disabled)
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CODA_FS is not set
# CONFIG_AFS_FS is not set
# CONFIG_ORANGEFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_DLMFS is not set

# =============================================================================
# DISABLE: Unused Hardware Drivers
# =============================================================================

# Storage (keep only NVMe and VirtIO)
# CONFIG_BLK_DEV_FD is not set          # Floppy
# CONFIG_BLK_DEV_LOOP is not set        # Loop devices (enable if needed)
# CONFIG_BLK_DEV_RAM is not set         # RAM disk
# CONFIG_ATA is not set                  # SATA/IDE (not used in WSL2)
# CONFIG_SCSI_LOWLEVEL is not set       # Legacy SCSI

# Network (keep only VirtIO)
# CONFIG_ETHERNET is not set            # Physical Ethernet
# CONFIG_WLAN is not set                # WiFi
# CONFIG_WIRELESS is not set

# Input devices
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# USB (not used in WSL2 typically)
# CONFIG_USB is not set
# CONFIG_USB_SUPPORT is not set

# Sound
# CONFIG_SOUND is not set

# Bluetooth
# CONFIG_BT is not set

# Wireless
# CONFIG_RFKILL is not set

# Hardware monitoring
# CONFIG_HWMON is not set

# Thermal
# CONFIG_THERMAL is not set

# Watchdog
# CONFIG_WATCHDOG is not set

# GPIO
# CONFIG_GPIOLIB is not set

# I2C
# CONFIG_I2C is not set

# SPI
# CONFIG_SPI is not set

# 1-Wire
# CONFIG_W1 is not set

# Power supply
# CONFIG_POWER_SUPPLY is not set

# Media
# CONFIG_MEDIA_SUPPORT is not set

# Graphics (WSLg handles this)
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set

# Crypto hardware acceleration (keep software crypto)
# CONFIG_CRYPTO_HW is not set

# =============================================================================
# DISABLE: Debugging and Tracing (Production Build)
# =============================================================================

# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_OPROFILE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_PLIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_DEBUG_NOTIFIERS is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_LOCKDEP is not set
# CONFIG_TRACE_IRQFLAGS is not set
# CONFIG_DEBUG_KOBJECT is not set
# CONFIG_DEBUG_HIGHMEM is not set
# CONFIG_DEBUG_STACKOVERFLOW is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_FRAME_POINTER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_KGDB is not set

# =============================================================================
# DISABLE: Security Features (Speed over Security)
# =============================================================================
#
# WARNING: Only disable these for trusted workloads!
# These improve performance but reduce security.
#

# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_YAMA is not set
# CONFIG_SECURITY_LANDLOCK is not set

# LSM hooks (small overhead, can keep)
# CONFIG_SECURITY_NETWORK is not set

# Audit (logging overhead)
# CONFIG_AUDIT is not set
# CONFIG_AUDITSYSCALL is not set

# =============================================================================
# OPTIONAL: Aggressive Optimizations
# =============================================================================
#
# Uncomment these for maximum performance, at cost of stability/features
#

# Disable kernel module support (all drivers built-in, faster boot)
# CONFIG_MODULES is not set

# Disable SMP (single CPU, no locking overhead)
# Only if you truly want single-core!
# CONFIG_SMP is not set

# Disable memory hotplug
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set

# Disable CPU hotplug
# CONFIG_HOTPLUG_CPU is not set

# Inline spinlocks (small code size increase, faster)
CONFIG_UNINLINE_SPIN_UNLOCK=n
CONFIG_INLINE_SPIN_LOCK=y
CONFIG_INLINE_SPIN_UNLOCK_IRQ=y
CONFIG_INLINE_READ_LOCK=y
CONFIG_INLINE_READ_UNLOCK=y
CONFIG_INLINE_WRITE_LOCK=y
CONFIG_INLINE_WRITE_UNLOCK=y

# =============================================================================
# KERNEL COMPRESSION
# =============================================================================

# LZ4 is fastest decompression
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_ZSTD is not set

# =============================================================================
# INITRAMFS
# =============================================================================

# Built-in initramfs (faster boot, no separate file)
CONFIG_BLK_DEV_INITRD=y
# CONFIG_INITRAMFS_SOURCE is set in build script

# =============================================================================
# SUMMARY
# =============================================================================
#
# This configuration:
# - Enables io_uring for async I/O
# - Optimizes for Zen 5 CPU (AVX-512)
# - Uses multi-queue block layer
# - Enables transparent huge pages
# - Uses PREEMPT_NONE for throughput
# - Strips all unused drivers
# - Disables debugging overhead
# - Uses LZ4 for fast decompression
#
# Expected impact:
# - 10-20% I/O latency reduction
# - 30-50% memory reduction
# - 50-75% boot time reduction
# - Some security features disabled
#
# =============================================================================
